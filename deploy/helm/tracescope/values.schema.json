{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["server", "secrets", "shop"],
  "properties": {
    "server": {"type": "object", "properties": {"replicas": {"type": "integer", "enum": [1]}, "samplingRate": {"type": "number", "minimum": 0, "maximum": 1}}},
    "secrets": {"type": "object", "properties": {"mcpToken": {"type": "string", "minLength": 12}, "chaosToken": {"type": "string", "minLength": 12}, "postgresPassword": {"type": "string", "minLength": 8}, "clickhousePassword": {"type": "string", "minLength": 8}}},
    "shop": {"type": "object", "properties": {"roles": {"type": "array", "items": {"enum": ["gateway", "checkout", "payment", "inventory"]}, "uniqueItems": true, "minItems": 4, "maxItems": 4}}}
  }
}
